generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth Models (Обязательно для OAuth) ---
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Для Credentials провайдера
  role          String    @default("user") // 'user' | 'admin'
  
  bio           String?   @db.Text
  age           Int?
  links         Json?     // Храним массив ссылок или объект { github: "", website: "" }
  location      String? 

  xp            Int       @default(0)       // Текущий опыт
  level         Int       @default(1)       // Текущий уровень
  streak        Int       @default(0)       // Дней обучения подряд
  lastActiveAt  DateTime?                   // Дата последней активности (для стриков)

  tags          Tag[]

  accounts      Account[]
  sessions      Session[]
  
  // Связи приложения
  generations   GeneratedContent[]
  testResults   TestResult[]
  progress      VideoProgress[] // История просмотров
  xpLogs XpLog[]
  aiFeedbacks   AiFeedback[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum VideoStatus {
  PENDING     // В очереди
  PROCESSING  // Скачиваем/Транскрибируем
  COMPLETED   // Готово
  FAILED      // Ошибка (видео удалено или API упал)
}

// --- Видео (Кэш) ---
model Video {
  id          String   @id @default(cuid())
  url         String   @unique
  platform    String   // 'youtube' | 'vk'
  status      VideoStatus @default(PENDING)
  externalId  String?
  title       String?
  thumbnail   String?
  duration    Int?
  cloudUrl    String?
  
  // Транскрипт хранится как JSONB (оптимизировано в Postgres)
  transcript  Json?    
  
  createdAt   DateTime @default(now())
  
  transcriptChunks  TranscriptChunk[]
  generatedContents GeneratedContent[]
  progress          VideoProgress[]
}

// --- Прогресс просмотра ---
model VideoProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  timestamp Int      // На какой секунде остановился
  isCompleted Boolean @default(false)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  tags        Tag[]

  @@unique([userId, videoId])
}

// --- Теги пользователя ---
model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String?  // Опционально: цвет тега (например, HEX '#ff0000')
  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Неявная связь многие-ко-многим с прогрессом (конкретным видео юзера)
  videoProgresses VideoProgress[]

  @@unique([userId, name]) // У одного юзера не может быть двух тегов с одинаковым именем
}

// --- Сгенерированный Контент ---
model GeneratedContent {
  id          String   @id @default(cuid())
  difficulty  String   // 'easy', 'medium', 'hard'
  mode        String   // 'student', 'teacher'
  audience    String   @default("student") // 'schoolboy', 'student', 'expert'
  focus       String   @default("theory")  // 'theory', 'practice', 'facts'
  summary     String   @db.Text
  
  // --- Телеметрия LLM ---
  latencyMs   Int?     // Время ответа API в миллисекундах
  tokensUsed  Int?     // Израсходованные токены
  
  createdAt   DateTime @default(now())
  
  userId      String
  videoId     String
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  flashcards  Flashcard[]
  questions   QuizQuestion[]
  testResults TestResult[]
  feedbacks   AiFeedback[]

  @@index([videoId, userId]) // Для быстрого получения контента юзера по видео
}

model Flashcard {
  id          String   @id @default(cuid())
  term        String
  definition  String   @db.Text
  
  contentId   String
  content     GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id          String   @id @default(cuid())
  text        String   @db.Text
  timestamp   Float     
  options     Json     
  correctIdx  Int      
  explanation String?  @db.Text
  
  contentId   String
  content     GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model TestResult {
  id          String   @id @default(cuid())
  score       Int      
  total       Int      
  completedAt DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId   String
  content     GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model TranscriptChunk {
  id        String   @id @default(cuid())
  videoId   String
  startTime Float    // Время в секундах (с точностью до мс)
  endTime   Float
  text      String   @db.Text

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId]) // Индекс для быстрого поиска субтитров к видео
}

model AiFeedback {
  id               String           @id @default(cuid())
  isLiked          Boolean          
  comment          String?          @db.Text
  createdAt        DateTime         @default(now())
  
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  generatedContentId String
  generatedContent   GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@index([generatedContentId])
}